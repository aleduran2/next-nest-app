# Local: docker compose up -d db (ver docker-compose.yml)
# Producción: la connection string que te da Render/Railway/Neon/Supabase
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tasks_dev"

# Access token: vida corta, se manda en cada request (header Authorization)
JWT_ACCESS_SECRET="cambia-esto-por-un-secreto-largo-y-random-en-produccion"
JWT_ACCESS_EXPIRES_IN="15m"

# Refresh token: vida larga, solo se usa para pedir un access token nuevo
JWT_REFRESH_SECRET="otro-secreto-distinto-al-de-access-en-produccion"
JWT_REFRESH_EXPIRES_IN="7d"

FRONTEND_URL="http://localhost:3000"
PORT=4000
